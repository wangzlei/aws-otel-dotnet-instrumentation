# This Docker file builds auto-instrumentation image for aws-otel-dotnet-instrumentation following upstream Docker build instruction:
# https://github.com/open-telemetry/opentelemetry-operator/blob/main/autoinstrumentation/dotnet/Dockerfile
#   The packages are installed in the `/autoinstrumentation` directory. This is required as when instrumenting the pod by CWOperator,
#   one init container will be created to copy all the content in `/autoinstrumentation` directory to app's container. Then
#   update the environment variables accordingly.

# Stage 1: Build the cp-utility binary
FROM public.ecr.aws/docker/library/rust:1.89 AS builder

WORKDIR /usr/src/cp-utility
COPY ./tools/cp-utility .

## TARGETARCH is automatically defined by Docker when using --platform flag
# https://docs.docker.com/engine/reference/builder/#automatic-platform-args-in-the-global-scope
ARG TARGETARCH

# Run validations and audit only on amd64 because it is faster and those two steps
# are only used to validate the source code and don't require anything that is
# architecture specific.

# Validations
# Validate formatting
RUN if [ $TARGETARCH = "amd64" ]; then rustup component add rustfmt && cargo fmt --check ; fi

# Audit dependencies
RUN if [ $TARGETARCH = "amd64" ]; then cargo install cargo-audit --locked && cargo audit ; fi

# Cross-compile based on the target platform.
RUN if [ $TARGETARCH = "amd64" ]; then export ARCH="x86_64" ; \
    elif [ $TARGETARCH = "arm64" ]; then export ARCH="aarch64" ; \
    else false; \
    fi \
    && rustup target add ${ARCH}-unknown-linux-musl \
    && cargo test --target ${ARCH}-unknown-linux-musl \
    && cargo install --target ${ARCH}-unknown-linux-musl --path . --root .

# Stage 2: Add arch-agnostic linux/linux-musl symlinks pointing at the existing
# arch-suffixed profiler directories, so OpenTelemetry Operator >= 0.157 (which injects
# .../linux/...) works while older operators that inject .../linux-x64/... keep working.
# On arm64 also add linux-x64/linux-musl-x64 aliases, because the CloudWatch Agent Operator
# injects those paths regardless of the node architecture.
# Needs a shell, so it cannot run in the scratch stage; reuse the builder image to avoid
# pulling another base image.
FROM public.ecr.aws/docker/library/rust:1.89 AS layout

ARG TARGETARCH

WORKDIR /autoinstrumentation
COPY OpenTelemetryDistribution/${TARGETARCH} ./
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) DOTNET_ARCH=x64 ;; \
      arm64) DOTNET_ARCH=arm64 ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    for dir in "linux-${DOTNET_ARCH}" "linux-musl-${DOTNET_ARCH}"; do \
      test -f "${dir}/OpenTelemetry.AutoInstrumentation.Native.so" \
        || { echo "missing ${dir}/OpenTelemetry.AutoInstrumentation.Native.so" >&2; exit 1; }; \
    done; \
    ln -s "linux-${DOTNET_ARCH}" linux; \
    ln -s "linux-musl-${DOTNET_ARCH}" linux-musl; \
    if [ "${DOTNET_ARCH}" != "x64" ]; then \
      ln -s "linux-${DOTNET_ARCH}" linux-x64; \
      ln -s "linux-musl-${DOTNET_ARCH}" linux-musl-x64; \
    fi; \
    ln -s . glibc; \
    ln -s . musl

# The two self-referencing links above make the files also available at the paths the upstream OTel Injector uses
# (OTEL_DOTNET_AUTO_HOME=<prefix>/<glibc|musl>, profiler <prefix>/glibc/linux-<arch>/ or
# <prefix>/musl/linux-musl-<arch>/), so one image serves both today's operator injection and the Injector without
# shipping the files twice. COPY and the image's cp (tools/cp-utility) keep all these links as links.

# Stage 3: Download the pinned OTel Injector release (built in tools/otel-injector of the ADOT Python repository) and
# verify it. Both architectures go into every image; cp-utility installs only the one matching the node.
# The last two checks read the ELF e_machine field (offset 18, little endian): 62 = x86_64, 183 = aarch64.
# TODO: the defaults are the development release; set them to the first official aws-otel-injector-v* release.
FROM --platform=$BUILDPLATFORM public.ecr.aws/docker/library/alpine:3.22 AS otel-injector
ARG OTEL_INJECTOR_RELEASE_BASE_URL=https://github.com/aws-observability/aws-otel-python-instrumentation/releases/download
ARG OTEL_INJECTOR_VERSION=0.11.0-1
ARG OTEL_INJECTOR_SHA256_AMD64=c9ea9b2051d70ead7cca7155664c8dd927fc111b9b2e711795f95b985b03f4e0
ARG OTEL_INJECTOR_SHA256_ARM64=879219069478636c9c2632cf6816076eb084d0b25fd5c0cb1adfbc25a9c26e34
WORKDIR /out
RUN set -e; \
    base="${OTEL_INJECTOR_RELEASE_BASE_URL}/aws-otel-injector-v${OTEL_INJECTOR_VERSION}"; \
    wget -q -O libotelinject_amd64.so "${base}/libotelinject_amd64.so"; \
    wget -q -O libotelinject_arm64.so "${base}/libotelinject_arm64.so"; \
    echo "${OTEL_INJECTOR_SHA256_AMD64}  libotelinject_amd64.so" | sha256sum -c -; \
    echo "${OTEL_INJECTOR_SHA256_ARM64}  libotelinject_arm64.so" | sha256sum -c -; \
    [ "$(od -An -j18 -N2 -tu2 libotelinject_amd64.so | tr -d ' ')" = "62" ]; \
    [ "$(od -An -j18 -N2 -tu2 libotelinject_arm64.so | tr -d ' ')" = "183" ]

# Stage 4: Build the distribution image by copying the THIRD-PARTY-LICENSES, the custom built cp command from stage 1, OpenTelemetryDistribution with its links from stage 2 and the OTel Injector from stage 3 to their respective destinations
FROM scratch

# Required to copy attribute files to distributed docker images
ADD THIRD-PARTY-LICENSES ./THIRD-PARTY-LICENSES

COPY --from=builder /usr/src/cp-utility/bin/cp-utility /bin/cp
COPY --from=layout /autoinstrumentation /autoinstrumentation
COPY --from=otel-injector /out /autoinstrumentation/injector
